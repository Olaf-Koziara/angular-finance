# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/angular_finance?schema=public"

# JWT Configuration
# Access token secret (required)
JWT_SECRET=your-secret-key-change-this-in-production
# Access token expiration (short-lived for security)
JWT_EXPIRES_IN=15m

# Refresh token secret (optional, falls back to JWT_SECRET if not set)
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-in-production
# Refresh token expiration (long-lived)
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Configuration
# Set to 'true' in production to only send cookies over HTTPS
COOKIE_SECURE=false

# CORS Configuration
CORS_ORIGIN=http://localhost:4200
